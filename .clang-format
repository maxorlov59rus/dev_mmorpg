# Единый стиль кода для всего репозитория «Чёрная Материя» (dm-server + UE-плагины).
# Стиль: LLVM, 4-пробельные отступы (как в уже отформатированном SmartAI.cpp).
# CI lint:cpp-format обязан использовать ЭТОТ файл (без явного --style),
# чтобы проверка была детерминированной на любой машине.
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Empty
PointerAlignment: Right
DerivePointerAlignment: false
IncludeBlocks: Preserve
SortIncludes: Never
NamespaceIndentation: None
