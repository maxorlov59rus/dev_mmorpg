<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="spirit-battle-root" class="spirit-battle-container">
        <ui:Label name="spirit-battle-title" text="Битва Духов" class="title-label" />
        
        <ui:VisualElement name="battle-section" class="section">
            <ui:Label name="status-label" text="Ожидание начала ивента" class="status-label" />
            <ui:Label name="queue-count" text="В очереди: 0" />
            <ui:Label name="timer-label" text="Время: --:--" />
            <ui:VisualElement name="battle-actions" class="button-row">
                <ui:Button name="join-queue-button" text="Записаться" class="action-button" />
                <ui:Button name="leave-queue-button" text="Покинуть очередь" class="action-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="participants-section" class="section">
            <ui:Label text="Участники" class="section-title" />
            <ui:ListView name="participant-list" class="participant-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
