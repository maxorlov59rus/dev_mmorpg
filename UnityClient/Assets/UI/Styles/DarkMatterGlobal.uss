/* ============================================================
   Чёрная Материя — глобальная тема клиента
   Палитра: угольный фон, багряный акцент, золото Света
   ============================================================ */

.root {
    --dm-bg: #0b0910;
    --dm-panel: rgba(20, 18, 26, 0.96);
    --dm-panel-alt: #1a1720;
    --dm-border: #332c3d;
    --dm-accent: #b83848;
    --dm-accent-soft: #7a2430;
    --dm-gold: #efcc8c;
    --dm-text: #ede9f2;
    --dm-muted: #9d96a8;
    --dm-hp: #b8333d;
    --dm-mp: #4270d1;
    --dm-xp: #c9a353;
    flex-grow: 1;
}

.screen-menu {
    flex-grow: 1;
    background-color: rgb(11, 9, 16);
    justify-content: center;
    align-items: center;
}

.menu-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 42%;
    background-image: linear-gradient(180deg, rgba(140, 24, 44, 0.34), rgba(11, 9, 16, 0));
}

.menu-center {
    align-items: center;
    width: 760px;
}

.menu-title {
    font-size: 96px;
    color: rgb(239, 204, 140);
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 6px;
}

.menu-subtitle {
    font-size: 24px;
    color: rgb(157, 150, 168);
    -unity-text-align: middle-center;
    letter-spacing: 8px;
    margin-bottom: 28px;
}

.menu-tagline {
    font-size: 19px;
    color: rgb(157, 150, 168);
    -unity-text-align: middle-center;
    margin-bottom: 48px;
    white-space: normal;
}

.menu-buttons {
    width: 360px;
}

.menu-button {
    height: 54px;
    margin-bottom: 12px;
    font-size: 20px;
    color: rgb(237, 233, 242);
    background-color: rgba(26, 23, 32, 1);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 4px;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: rgba(48, 34, 42, 1);
    border-color: rgb(184, 56, 72);
}

.menu-button-primary {
    background-color: rgb(184, 56, 72);
    border-color: rgb(217, 96, 112);
    color: rgb(255, 248, 245);
    font-size: 21px;
}

.menu-button-primary:hover {
    background-color: rgb(204, 68, 86);
}

.menu-button-ghost {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(157, 150, 168);
    border-color: transparent;
}

.menu-footer {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    font-size: 14px;
    color: rgb(120, 114, 130);
    -unity-text-align: middle-center;
}

/* ---------- generic window ---------- */

.screen-panel,
.window {
    position: absolute;
    background-color: rgba(20, 18, 26, 0.97);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 6px;
}

.screen-panel {
    left: 15%;
    right: 15%;
    top: 10%;
    bottom: 10%;
}

.window {
    width: 620px;
    height: 560px;
    left: 50%;
    top: 50%;
    margin-left: -310px;
    margin-top: -280px;
}

.window-wide {
    width: 860px;
    margin-left: -430px;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 44, 61);
    background-color: rgba(30, 25, 36, 0.9);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.panel-title {
    font-size: 24px;
    color: rgb(239, 204, 140);
    letter-spacing: 1px;
}

.panel-subtitle {
    font-size: 15px;
    color: rgb(157, 150, 168);
}

.close-button {
    width: 32px;
    height: 32px;
    background-color: rgba(184, 56, 72, 0.2);
    color: rgb(237, 233, 242);
    border-width: 0;
    border-radius: 4px;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.close-button:hover {
    background-color: rgb(184, 56, 72);
}

.window-scroll {
    flex-grow: 1;
    padding: 12px 16px;
}

.section-title {
    font-size: 17px;
    color: rgb(239, 204, 140);
    margin-top: 10px;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.muted {
    font-size: 15px;
    color: rgb(157, 150, 168);
}

.empty-state {
    font-size: 17px;
    color: rgb(157, 150, 168);
    -unity-text-align: middle-center;
    padding: 40px 0;
}

.button-primary {
    height: 44px;
    margin-top: 14px;
    background-color: rgb(184, 56, 72);
    color: rgb(255, 248, 245);
    border-width: 0;
    border-radius: 4px;
    font-size: 18px;
}

.button-primary:hover {
    background-color: rgb(204, 68, 86);
}

/* ---------- main menu / character select ---------- */

.char-body {
    flex-direction: row;
    flex-grow: 1;
    padding: 18px;
}

.char-list {
    flex-grow: 1;
    margin-right: 18px;
}

.char-card {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 10px;
    background-color: rgb(26, 23, 32);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 4px;
}

.char-card:hover {
    border-color: rgb(184, 56, 72);
}

.char-create {
    width: 320px;
    padding-left: 18px;
    border-left-width: 1px;
    border-left-color: rgb(51, 44, 61);
}

/* ---------- HUD ---------- */

.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 22px;
    background-color: rgba(15, 13, 20, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 44, 61);
}

.topbar-left,
.topbar-right {
    flex-direction: row;
    align-items: center;
}

.topbar-left { flex-grow: 1; }
.topbar-center { justify-content: center; }

.topbar-name {
    font-size: 20px;
    color: rgb(239, 204, 140);
    margin-right: 14px;
}

.topbar-chip {
    font-size: 15px;
    color: rgb(237, 233, 242);
    padding: 3px 10px;
    margin-right: 8px;
    background-color: rgba(51, 44, 61, 0.7);
    border-radius: 10px;
}

.topbar-faction {
    color: rgb(239, 204, 140);
}

.topbar-zone {
    font-size: 17px;
    color: rgb(157, 150, 168);
}

.topbar-clock,
.topbar-weather {
    font-size: 15px;
    color: rgb(157, 150, 168);
    margin-right: 14px;
}

.topbar-gold {
    font-size: 17px;
    color: rgb(239, 204, 140);
    margin-right: 14px;
}

.topbar-spirit {
    font-size: 17px;
    color: rgb(150, 200, 255);
}

.hud-vitals {
    position: absolute;
    left: 20px;
    bottom: 20px;
    width: 320px;
    padding: 14px 16px;
    background-color: rgba(15, 13, 20, 0.9);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 6px;
}

.vitals-label {
    font-size: 14px;
    color: rgb(237, 233, 242);
    margin-bottom: 4px;
}

.vitals-xp-label {
    margin-top: 8px;
}

.bar {
    height: 18px;
    margin-bottom: 8px;
    background-color: rgb(38, 34, 46);
    border-radius: 3px;
}

.bar-thin {
    height: 10px;
}

.bar-fill {
    height: 100%;
    border-radius: 3px;
}

.bar-hp { background-color: rgb(184, 51, 61); width: 82%; }
.bar-mp { background-color: rgb(66, 112, 209); width: 64%; }
.bar-xp { background-color: rgb(201, 163, 83); width: 46%; }

.hud-chat {
    position: absolute;
    left: 20px;
    bottom: 210px;
    width: 520px;
    height: 300px;
    background-color: rgba(15, 13, 20, 0.86);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 6px;
}

.chat-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 44, 61);
}

.chat-channel {
    font-size: 15px;
    color: rgb(239, 204, 140);
    flex-grow: 1;
}

.chat-channel-button {
    height: 24px;
    font-size: 12px;
    color: rgb(157, 150, 168);
    background-color: rgba(51, 44, 61, 0.6);
    border-width: 0;
    border-radius: 3px;
    margin-right: 6px;
}

.chat-scroll {
    flex-grow: 1;
}

.chat-content {
    padding: 8px 12px;
}

.chat-line {
    font-size: 15px;
    color: rgb(237, 233, 242);
    white-space: normal;
    margin-bottom: 4px;
}

.chat-line-author {
    color: rgb(239, 204, 140);
}

.chat-input-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-top-width: 1px;
    border-top-color: rgb(51, 44, 61);
}

.chat-input {
    flex-grow: 1;
    height: 30px;
}

.chat-input .unity-text-field__input {
    background-color: rgba(38, 34, 46, 1);
    color: rgb(237, 233, 242);
    border-width: 0;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 15px;
}

.chat-placeholder {
    color: rgb(120, 114, 130);
    font-size: 14px;
}

.chat-send {
    width: 34px;
    height: 30px;
    margin-left: 6px;
    background-color: rgb(184, 56, 72);
    color: rgb(255, 248, 245);
    border-width: 0;
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.hud-hotkeys {
    position: absolute;
    bottom: 18px;
    left: 50%;
    margin-left: -360px;
    flex-direction: row;
}

.hotkey {
    height: 40px;
    margin-right: 6px;
    padding: 0 12px;
    font-size: 14px;
    color: rgb(237, 233, 242);
    background-color: rgba(26, 23, 32, 0.94);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 4px;
}

.hotkey:hover {
    border-color: rgb(184, 56, 72);
}

.hotkey-exit {
    background-color: rgba(184, 56, 72, 0.28);
    color: rgb(239, 204, 140);
}

/* ---------- quests ---------- */

.quest-row {
    padding: 12px 14px;
    margin-bottom: 10px;
    background-color: rgb(26, 23, 32);
    border-left-width: 3px;
    border-left-color: rgb(184, 56, 72);
    border-radius: 4px;
}

.quest-name {
    font-size: 18px;
    color: rgb(237, 233, 242);
}

.quest-desc {
    font-size: 14px;
    color: rgb(157, 150, 168);
    white-space: normal;
    margin-top: 4px;
}

.quest-progress {
    font-size: 14px;
    color: rgb(239, 204, 140);
    margin-top: 6px;
}

/* ---------- inventory ---------- */

.inventory-head {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 18px;
}

.inventory-money {
    font-size: 16px;
    color: rgb(239, 204, 140);
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 16px 16px 16px;
}

.inventory-slot {
    width: 76px;
    height: 76px;
    margin: 5px;
    background-color: rgb(26, 23, 32);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 5px;
    justify-content: flex-end;
    align-items: center;
}

.inventory-slot:hover {
    border-color: rgb(239, 204, 140);
}

.inventory-slot-label {
    font-size: 11px;
    color: rgb(157, 150, 168);
    -unity-text-align: middle-center;
    padding-bottom: 4px;
    white-space: normal;
}

.inventory-slot.empty {
    opacity: 0.45;
}

/* ---------- profile ---------- */

.profile-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.profile-avatar {
    width: 96px;
    height: 96px;
    margin-right: 18px;
    background-image: linear-gradient(135deg, rgba(122, 36, 48, 0.8), rgba(30, 25, 36, 0.9));
    border-width: 1px;
    border-color: rgb(184, 56, 72);
    border-radius: 48px;
    justify-content: center;
    align-items: center;
}

.profile-avatar-glyph {
    font-size: 44px;
    color: rgb(239, 204, 140);
}

.profile-name {
    font-size: 24px;
    color: rgb(237, 233, 242);
}

.profile-sub {
    font-size: 15px;
    color: rgb(157, 150, 168);
    margin-top: 2px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.stat-name {
    width: 140px;
    font-size: 15px;
    color: rgb(157, 150, 168);
}

.stat-bar {
    flex-grow: 1;
    height: 12px;
    background-color: rgb(38, 34, 46);
    border-radius: 3px;
}

.stat-bar-fill {
    height: 100%;
    background-color: rgb(184, 56, 72);
    border-radius: 3px;
}

/* ---------- campaigns ---------- */

.campaign-row {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 10px;
    background-color: rgb(26, 23, 32);
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 4px;
}

.campaign-row:hover {
    border-color: rgb(184, 56, 72);
}

.campaign-name {
    flex-grow: 1;
    font-size: 18px;
    color: rgb(237, 233, 242);
}

.campaign-levels {
    width: 90px;
    font-size: 15px;
    color: rgb(239, 204, 140);
}

.campaign-faction {
    width: 150px;
    font-size: 14px;
    color: rgb(157, 150, 168);
}

.campaign-diff {
    width: 90px;
    font-size: 14px;
    color: rgb(239, 204, 140);
    -unity-text-align: middle-right;
}

/* ---------- map ---------- */

.map-canvas {
    flex-grow: 1;
    margin: 14px 16px;
    background-color: #12101a;
    border-width: 1px;
    border-color: rgb(51, 44, 61);
    border-radius: 5px;
}

.map-region {
    position: absolute;
    border-width: 1px;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    opacity: 0.85;
}

.map-region-light {
    left: 18px;
    top: 18px;
    width: 260px;
    height: 180px;
    background-color: rgba(239, 204, 140, 0.16);
    border-color: rgba(239, 204, 140, 0.6);
}

.map-region-dark {
    right: 18px;
    top: 18px;
    width: 240px;
    height: 200px;
    background-color: rgba(122, 36, 48, 0.28);
    border-color: rgba(184, 56, 72, 0.7);
}

.map-region-neutral {
    left: 50%;
    bottom: 18px;
    margin-left: -180px;
    width: 360px;
    height: 150px;
    background-color: rgba(120, 150, 120, 0.14);
    border-color: rgba(140, 180, 140, 0.5);
}

.map-region-label {
    font-size: 17px;
    color: rgb(237, 233, 242);
}

.map-player {
    position: absolute;
    left: 150px;
    top: 120px;
    width: 14px;
    height: 14px;
    background-color: rgb(239, 204, 140);
    border-radius: 7px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.map-legend {
    flex-direction: row;
    padding: 0 18px 14px 18px;
}

.map-legend-item {
    font-size: 14px;
    margin-right: 18px;
}

.legend-light { color: rgb(239, 204, 140); }
.legend-dark { color: rgb(217, 96, 112); }
.legend-neutral { color: rgb(150, 200, 150); }
.legend-player { color: rgb(237, 233, 242); }

/* ---------- guild ---------- */

.guild-war-row,
.guild-ally-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px 12px;
    margin-bottom: 8px;
    background-color: rgb(26, 23, 32);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(184, 56, 72);
}

.guild-war-name,
.guild-ally-name {
    font-size: 16px;
    color: rgb(237, 233, 242);
}

.guild-war-score {
    font-size: 15px;
    color: rgb(239, 204, 140);
}

/* ---------- toast ---------- */

.toast {
    position: absolute;
    left: 50%;
    margin-left: -200px;
    top: 74px;
    width: 400px;
    padding: 10px 16px;
    background-color: rgba(184, 56, 72, 0.94);
    border-radius: 4px;
    justify-content: center;
}

.toast-text {
    font-size: 16px;
    color: rgb(255, 248, 245);
    -unity-text-align: middle-center;
    white-space: normal;
}

.hidden {
    display: none;
}
