; =====================================================================
; «Чёрная Материя» — определения протокола (исходник кодогенератора)
; Формат: простой .defs → генератор tools/proto-gen выдаёт:
;   - C++ structs (dm-server/src/shared/Protocol)
;   - C++/Blueprint-обёртки для UE (DMClient Source/DarkMatter/Net/gen)
;   - Lua таблицы констант (script VM)
; Типы: u8 u16 u32 u64 i32 i64 fp16(Q16.16) str{n} guid(=u32) bytes arr<T>{max}
; Порядок полей = wire order. Новые поля — только в конец (additive rule, docs/03 §7).
; =====================================================================

@version 2

; ---------- AUTH (TCP :8091) ----------
@opcode CMSG_AUTH_CHALLENGE 0x0001 chan=auth dir=c2s {
    str<64> email
}
@opcode SMSG_AUTH_CHALLENGE 0x0002 chan=auth dir=s2c {
    bytes<128> salt_B
    bytes<128> pubkey_N_g
}
@opcode CMSG_AUTH_PROOF 0x0003 chan=auth dir=c2s {
    bytes<128> A
    bytes<64>  M1
}
@opcode SMSG_AUTH_RESULT 0x0004 chan=auth dir=s2c {
    u8         ok                      ; 0=fail 1=ok 2=OTP-required
    bytes<64>  M2
    str<40>    realm_ticket
}

; ---------- WORLD (TCP :8092) ----------
@opcode CMSG_WORLD_HELLO 0x0010 chan=world dir=c2s {
    str<40>   ticket
    u32       client_build
    u8        platform                 ; 0=PC 1=ANDROID
    str<64>   device_id
    bytes<32> content_manifest_hash    ; сверка dbc/pak версий
}
@struct CharInfo {
    guid   id
    str<24> name
    u8     class
    u8     faction
    u8     level
    u16    map_id
    u8     deleted
}
@opcode SMSG_CHAR_LIST 0x0011 chan=world dir=s2c {
    arr<CharInfo>{10} chars
}
; ---- Character creation (v1.1: customization blob + faction) ----
; CustomizationBlob = канонический FCharacterCustomization (docs/charcreate §Protocol):
;   u16 BlobVersion | u8 MorphCount | MorphCount * { u16 SliderId; u16 ValueX1000 }
; | u8 HairStyle | u8 HairColorIdx | u8 EyeColorIdx | u8 SkinToneIdx
; | ColorBGRA ClothingPrimary | ColorBGRA ClothingSecondary | u16 Reserved
; Жёсткий лимит blob на проводе: 512 байт (валидация сервера до парсинга).
@opcode CMSG_CHAR_CREATE 0x0012 chan=world dir=c2s {
    str<24> name
    u8      race
    u8      class
    u8      gender
    u8      faction                      ; 1=Орден Рассвета 2=Круг Поглощения 3=Гильдия Порога
    bytes   customization_blob           ; см. выше (<=512 B, LE)
}
@opcode SMSG_CHAR_CREATE_SUCCESS 0x0013 chan=world dir=s2c {
    guid     id
    str<24>  name
    u8       race
    u8       class
    u8       gender
    u8       faction
    u16      start_map                   ; стартовая карта по расе/фракции
    i32      start_x i32 start_y i32 start_z   ; Q16.16 fixed
    fp16     start_o                     ; orientation yaw, Q16.16
    bytes    preview_customization       ; нормализованный blob — мгновенный рендер в списке без БД
}
@opcode SMSG_CHAR_CREATE_ERROR 0x0017 chan=world dir=s2c {
    u8 reason                            ; см. ECharCreateError: 1=name_invalid ...
}
@opcode CMSG_CHAR_SELECT 0x0014 chan=world dir=c2s {
    guid id
}
@opcode SMSG_MAP_ASSIGN 0x0015 chan=world dir=s2c {
    str<48> ip
    u16     port
    bytes<16> map_session_key
    str<40> reconnect_token
    u16     map_id
}

@opcode CMSG_CHAT_SEND 0x0020 chan=world dir=c2s {
    u8    channel                      ; 0=say 1=party 2=raid 3=guild 4=zone 5=whisper
    guid  whisper_target
    str<256> text
}
@opcode SMSG_CHAT_RECV 0x0021 chan=world dir=s2c {
    u8   channel
    guid sender
    str<24> sender_name
    str<256> text
}

; ---------- ФРАКЦИИ / ЧЁРНАЯ МАТЕРИЯ ----------
@struct FrontlinePointState {
    u16 point_id
    u8  owner_faction                  ; 0=ничейно 1..3 фракции
    u16 hold_progress_pct_x10          ; 0..1000
}
; ---- Reputation / Renegade (v1.2: система фракций, см. ReputationMgr.h) ----
; faction: 1=Стражи Света(Орден Рассвета) 2=Падшие(Круг Поглощения)
;          3=Гильдия Порога 4=служебная фракция ИЗГОЕВ (renegades)
; standing = Q16 fixed int32 (1 очко репутации = 16 ед; пороги рангов в Faction.dbc)
; rank:    0=Hated 1=Hostile 2=Unfriendly 3=Neutral 4=Friendly 5=Honored 6=Revered 7=Exalted
@opcode SMSG_REP_UPDATE 0x0075 chan=world dir=s2c {
    u8   faction
    i32  standing
    u8   rank
}
; Инвариант ренегата на сервере: repA < -5000 И repB < 0 (ReputationMgr::CrossedRenegadeState).
; При переходе: авто-выдача скрытого квеста q_1003 «Изгой», atWarWithAll=true,
; включение vein-шейдера ЧМ на модели (SMSG_FACTION_VISUAL -> FactionFXManager.cpp).
@opcode SMSG_RENEGADE_STATE 0x0076 chan=world dir=s2c {
    u8   is_renegade                   ; 0/1 — флаг изгоя (PvP red nameplate, города закрыты)
    u8   at_war_with_all
    u16  black_market_unlocked         ; 1 = q_1003 сдан, доступен VENDOR_BLACK_MARKET
}
@opcode SMSG_FACTION_VISUAL 0x0077 chan=map dir=s2c {
    guid unit_guid                     ; юнит, которому применяется FX (в т.ч. self)
    u8   faction                       ; целевая фракция для материала/палитры
    u8   apply_black_matter_fx         ; 1 = включить пульсирующие вены (WPO+Emissive)
}
@opcode SMSG_CREATURE_AGGRO 0x0078 chan=map dir=s2c {
    guid creature_guid
    guid target_guid                   ; для анимации «страж заметил изгоя» в AOI
}
@opcode SMSG_FACTION_STATE 0x0070 chan=world dir=s2c {
    u8   season_active
    u32  season_ends_ms_lo             ; epoch ms (u64 разбит для выравнивания)
    u32  season_ends_ms_hi
    arr<FrontlinePointState>{32} points
}
@struct SeepageInfo {
    u16 zone_id
    u8  intensity                      ; 1..5
    u32 ends_ms_lo
}
@opcode SMSG_SEEPAGE_LIST 0x0073 chan=world dir=s2c {
    arr<SeepageInfo>{16} zones         ; активные Истечения (клиент включает VFX/музыку)
}
@opcode CMSG_CORRUPTION_QUERY 0x0071 chan=world dir=c2s {}
@opcode SMSG_CORRUPTION_STATE 0x0074 chan=world dir=s2c {
    u16 value_x100                     ; 0..10000
    u8  altered                        ; флаг Изменённого
}

; ---------- MAP (UDP/KCP :8093+) ----------
@struct MoveSubTick {
    i16 dx                             ; relative, шаг 0.5см
    i16 dy
    i16 dz
    u8  dir_x8                         ; orientation quantized
    u8  flags                          ; bit0 run bit1 jump bit2 swim bit3 in-air
}
@opcode CMSG_MOVE_TICK 0x1001 chan=map dir=c2s {
    u32 seq
    u32 time_ms_lo                     ; client clock (sync через ping)
    arr<MoveSubTick>{3} ticks
}
@opcode SMSG_SNAPSHOT 0x1010 chan=map dir=s2c {
    u32 snapshot_seq
    u32 server_time_ms_lo
    guid self_guid
    arr<EntityFull>{400} entities      ; см. EntityFull ниже
}
@struct EntityFull {
    guid  id
    u8    type                         ; 0 player 1 creature 2 go 3 projectile 4 loot
    u16   entry                        ; dbc entry
    i32   x i32 y i32 z                ; absolute fixed Q16.16
    u16   anim_state
    u8    faction
    u16   hp_pct_x100
    u32   auras_crc                    ; хэш списка аур — триггер полного resync
}
@struct EntityDelta {
    guid id
    u8   fields_mask                   ; bit0 pos bit1 rot bit2 anim bit3 hp bit4 aura-crc ...
    ; опциональные поля следуют в порядке битов mask
}
@opcode SMSG_DELTA 0x1011 chan=map dir=s2c {
    u32 from_seq
    u32 to_seq
    arr<EntityDelta>{64} deltas
}
@opcode CMSG_AOI_ACK 0x1012 chan=map dir=c2s {
    u32 last_seq
}
@opcode CMSG_SET_INTEREST 0x1013 chan=map dir=c2s {
    u16 radius_m                       ; 90|120|200 — mobile tiering
    u8  detail_tier
}
@opcode CMSG_CAST 0x1020 chan=map dir=c2s {
    u32 spell_id
    u8  target_count
    arr<guid>{3} targets
    i32 src_x i32 src_y i32 src_z      ; skill-shot origin (античит LOS)
}
@opcode SMSG_CAST_RESULT 0x1022 chan=map dir=s2c {
    u32 spell_id
    guid caster
    u8  outcome                        ; 0 miss 1 hit 2 immune 3 interrupted
    u16 flags                          ; crit/dodge/parry/block/resist-school
    arr<DamageUnit>{8} dmg
}
@struct DamageUnit {
    guid victim
    i32 amount_fixed                   ; Q16.16, знак = heal
    u8  school
}
@opcode SMSG_SPAWN 0x1040 chan=map dir=s2c { EntityFull entity }
@opcode SMSG_DESPAWN 0x1041 chan=map dir=s2c { guid id u8 reason }
@opcode CMSG_PING 0x10FF chan=map dir=c2s { u32 client_time_ms_lo }
@opcode SMSG_PONG 0x1100 chan=map dir=s2c { u32 client_time_ms_lo u32 server_time_ms_lo }

; ---------- QUESTS (TCP/world, seq-acked) ----------
; quest_flags: bit0 repeatable_daily bit1 hidden(auto) bit2 autoaccept
;              bit3 autoreward bit4 faction_gated (см. sql/upgrades/StarterQuests.sql)
@struct QuestState {
    u32 quest_id
    u8  state                          ; 0 available 1 active 2 completable 3 done
    u8  progress                       ; счётчик простых kill/talk-goal'ей (0..255)
}
@opcode CMSG_QUEST_QUERY 0x2000 chan=world dir=c2s {}
@opcode SMSG_QUEST_LIST 0x2001 chan=world dir=s2c {
    arr<QuestState>{64} quests         ; журнал + стартовые available-квесты зоны
}
@opcode CMSG_QUEST_ACCEPT 0x2002 chan=world dir=c2s { u32 quest_id }
@opcode CMSG_QUEST_COMPLETE 0x2003 chan=world dir=c2s { u32 quest_id }
@opcode SMSG_QUEST_ACCEPTED 0x2004 chan=world dir=s2c {
    u32 quest_id
    str<128> title
    str<256> objectives
    u8  quest_flags
}
@opcode SMSG_QUEST_PROGRESS 0x2005 chan=world dir=s2c { u32 quest_id u8 progress }
@opcode SMSG_QUEST_COMPLETE_RESULT 0x2006 chan=world dir=s2c {
    u32 quest_id
    u8  result                         ; 0 ok 1 not_ready 2 already_done 3 cheat_reject
    i64 reward_money                   ; медь
    arr<u32>{6} reward_items           ; item entries (0 = пусто)
    arr<i32>{4} reward_rep             ; пары (faction<<16|raw_delta) — Q16 ед ReputationMgr
}
@opcode SMSG_QUEST_TURN_IN_HINT 0x2007 chan=world dir=s2c { u32 quest_id guid npc_entry }

; ---------- GOSSIP / DIALOGUE (TCP/world) ----------
; Сервер фильтрует опции по dm_conditions (rep_rank_min/is_renegade/...),
; клиент НИКОГДА не показывает скрытые ветки; повторный guard на Select —
; защита от packet-replay (см. SmartAI::GossipOptionSatisfiesCondition).
@struct GossipTextEntry {                ; строка из broadcast_text (диалог мобов/NPC)
    u32 text_id
    str<256> text_ru                    ; локаль выбирается по client lang (M0: ru+en)
}
@struct GossipOption {
    u8   option_id                      ; gossip_menu_option.ID
    u8   icon                           ; 0 talk 1 quest! 2 quest? 3 vendor 7 rep
    u16  text_broadcast_id              ; ссылка на broadcast_text (озвучка/подпись)
    u8   has_quest                      ; 1 = рядом иконка квеста (!/?/…)
}
@opcode CMSG_GOSSIP_HELLO 0x2010 chan=world dir=c2s { guid npc_guid }
@opcode SMSG_GOSSIP_SHOW 0x2011 chan=world dir=s2c {
    guid npc_guid
    u32 menu_id
    u32 greeting_text_id               ; заголовок меню (broadcast_text)
    arr<GossipOption>{8} options       ; УЖЕ отфильтровано по условиям репутации
}
@opcode CMSG_GOSSIP_SELECT 0x2012 chan=world dir=c2s { guid npc_guid u8 option_id }
@opcode SMSG_GOSSIP_REPLY 0x2013 chan=world dir=s2c {
    guid npc_guid
    u32 text_id                        ; ответная реплика NPC (broadcast_text)
    u8  action                         ; 0 close 1 open_vendor 2 open_quest_log
                                       ; 3 quest_turn_in 4 rep_summary 5 black_market
    u32 payload_id                     ; vendor_rec / quest_id / доп. id
}
@opcode SMSG_CREATURE_TEXT 0x2014 chan=world dir=s2c {
    guid creature_guid
    u32 text_id                        ; реплика моба: агрория стража на изгоя (90100),
                                       ; таунты «Слизня» при аггро и т.п.
    u8  type                           ; 0 say 1 yell 2 emote 3 whisper-like
}

; ---------- CLASSES / SPECS / STATS (v1.4: промпт «Система классов») ----------
; race: 1 Human 2 Lumenar 3 Ashen 4 Hollowed 5 Thresholdkin   (PlayerClassMgr.h)
; class: 1 Warrior 2 Priest 3 Mage 4 Rogue 5 Hunter 6 Warlock
; spec_id: см. class_specs (sql/upgrades/Create_Class_Database.sql), 0 = нет спеки
; Валидация Race×Class×Faction×Spec — PlayerClassMgr::ValidateCreation ДО INSERT;
; отказ => SMSG_CHAR_CREATE_ERROR reason 7..12 (ClassCheckResult+6).
@opcode CMSG_CLASS_INFO_QUERY 0x0090 chan=world dir=c2s { u8 for_race } ; 0=all (экран создания)
@opcode SMSG_CLASS_INFO 0x0091 chan=world dir=s2c {
    guid char_guid                       ; 0 = превью для экрана создания
    u8   class                           ; CLASS_*
    u8   spec                            ; SPEC_* (текущая выбранная/активная)
    arr<u8>{6} allowed_races             ; обратный фильтр UI (0 terminates list)
}
@opcode SMSG_INITIALIZE_STATS 0x0092 chan=world dir=s2c {
    guid unit                            ; self при входе в мир
    u32  health_max u32 health_cur       ; display int (Q16 -> округление вверх)
    u8   power_type                      ; 0 none 1 mana 2 rage 3 energy
    u32  power_max u32 power_cur
    u32  strength u32 agility u32 stamina u32 intellect u32 spirit
    u32  armor u32 spell_power
}
@opcode SMSG_LEARN_SPELL 0x0093 chan=world dir=s2c {
    u32 spell_id                         ; классовая авто-способность (class_spells)
    u8  source                           ; 0 class_default 1 level_up 2 racial 3 spec (квест-награды — отдельный канал SMSG_QUEST_COMPLETE)
}

; ---------- QUESTS 6-10: SPEC SELECTION + LFG (v1.5, промпт «Квестовая система 6–10») ----------
; Квесты цепочки 6–10: диапазон ID 1101..1105 (контракт sql/upgrades/Insert_Quests_6_to_10.sql
; и enum StarterQuestId6to10 в QuestSystem_Level10.h). q_1104 «Путь избранного» —
; автовыдача на 10 уровне (SpecQuestMgr::OnLevelChanged), выбор спеки ТОЛЬКО через
; CMSG_CHOOSE_SPEC с серверным guard (PlayerClassMgr::SpecBelongsToClass).
; Роли LFG: биты 1=tank 2=healer 4=dps (LfgRoleFlags); RequiredRolesMask данжа = 7.
@opcode CMSG_JOIN_LFG          0x2020 chan=world dir=c2s { u16 dungeon_id u8 role_flags }
@opcode SMSG_LFG_QUEUE_STATE   0x2021 chan=world dir=s2c {
    u8 state                                 ; 0 none/rejected 1 queued 2 proposal 3 in_instance
    u16 dungeon_id
    u32 est_wait_ms                          ; EWMA-оценка (M1 — эвристика размера очереди)
}
@opcode SMSG_LFG_ROLE_CHECK    0x2022 chan=world dir=s2c {
    u16 dungeon_id
    u8 required_roles                        ; маска ролей данжа (lfg_dungeons.RequiredRolesMask)
    u8 ok                                    ; 1 = роль игрока принимаетcя очередью
}
@opcode SMSG_SPEC_SELECTION_OPEN 0x2023 chan=world dir=s2c {
    u8 class_id                              ; CLASS_* (клиент фильтрует DataTable DT_SpecPanel)
    u8 spec_count                            ; <= 4
    arr<u32>{4} spec_ids                     ; доступные SpecID (class_specs.spec_id)
}
@opcode CMSG_CHOOSE_SPEC       0x2024 chan=world dir=c2s { u8 spec_id }
@opcode SMSG_SPEC_CHOSEN       0x2025 chan=world dir=s2c {
    u8 spec_id                               ; подтверждение сервера (источник истины для UI)
    u8 lfg_role_mask                         ; роль для LFGQueueWidget (Танк/Хил/ДД)
}
@opcode SMSG_LEARNED_SPELLS_BATCH 0x2026 chan=world dir=s2c {
    u8 count                                 ; <= 16
    arr<u32>{16} spell_ids                   ; способности спеки (playercreateinfo_specs)
    u8 source                                ; 3 = spec (клиент: золотая подсветка action bar 10с)
}
@opcode CMSG_LFG_LEAVE         0x2027 chan=world dir=c2s { }
@opcode CMSG_LFG_PROPOSAL_ACCEPT 0x2028 chan=world dir=c2s { u8 accept } ; 0 = decline (вся группа расходится)
@opcode SMSG_LFG_PROPOSAL      0x2029 chan=world dir=s2c {
    u16 dungeon_id
    u32 map_id                               ; предпросмотр инстанса («Пещеры Испытаний» = 901)
    u64 leader_guid                          ; M1: первый по FIFO
}

# ---------------------------------------------------------------------
# v1.6 — Прогрессия 1–95 (docs/09, ProgressionCore.h/.cpp)
# Level-up/XP-синхронизация + древо талантов.
# ---------------------------------------------------------------------
@opcode SMSG_LEVEL_UPDATE 0x2030 chan=world dir=s2c { guid u8 new_level u64 xp_cumulative u64 xp_to_next u16 talent_points_total u16 talent_points_spent }
@opcode SMSG_XP_GAINED     0x2031 chan=map dir=s2c { guid u32 xp_amount u8 source } ; source: 0=mob 1=quest 2=script
@opcode CMSG_TALENT_QUERY  0x2032 chan=world dir=c2s { }
@opcode SMSG_TALENT_DATA   0x2033 chan=world dir=s2c { u16 tree_count [ tree_id u8 class u8 spec_id ] u16 node_count [ talent_id u16 tree u8 row u8 col u8 max_rank u8 type u8 req_points u8 req_level u8 prestige u32 aura_spell u32 active_spell ] }
@opcode CMSG_TALENT_LEARN  0x2034 chan=world dir=c2s { u32 talent_id u8 rank }
@opcode SMSG_TALENT_RESULT 0x2035 chan=world dir=s2c { u32 talent_id u8 rank u8 result } ; result: 0=ok 1=no_points 2=prereq 3=level 4=prestige_gate
@opcode CMSG_TALENT_RESET  0x2036 chan=world dir=c2s { }
@opcode SMSG_ITEM_EQUIP_UPDATE 0x2037 chan=map dir=s2c { guid u8 slot u32 item_id u16 ilvl u8 tier u8 armor_type }
